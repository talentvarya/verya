PORT=4173
# Supabase cloud persistence (keep the secret key server-side only).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback name if your project has not migrated its keys yet:
# SUPABASE_SERVICE_ROLE_KEY=...
# Optional isolated data file path for local fallback/testing.
# DATA_FILE=./data/store.json
